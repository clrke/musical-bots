{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix web --include=dev",
  "buildCommand": "npm --prefix web run build -- --base=/",
  "outputDirectory": "web/dist",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{director/**,scripts/director/**,scripts/validate-bundle.js,web/src/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "run",
          "value": "(?<run>[a-z0-9]{20,40})"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|slack|discord|whatsapp|telegram|linkedin|skype|embedly|preview).*"
        }
      ],
      "destination": "/api/index?path=share/:run"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
