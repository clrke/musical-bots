{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix web --include=dev",
  "buildCommand": "npm --prefix web run build -- --base=/",
  "outputDirectory": "web/dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{director/**,scripts/director/**,scripts/validate-bundle.js,web/src/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
